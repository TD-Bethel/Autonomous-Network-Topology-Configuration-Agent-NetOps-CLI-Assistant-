! Generated by netops-compiler. Review before use.
!
{% for vlan in design.vlans %}
vlan {{ vlan.vlan_id }}
 name {{ vlan.name }}
!
interface Vlan{{ vlan.vlan_id }}
 description {{ vlan.site }} {{ vlan.purpose }}
 ip address {{ vlan.gateway }} {{ vlan.prefix | ipv4_netmask }}
 ip ospf {{ design.ospf_process_id }} area {{ design.ospf_area }}
 no shutdown
!
{% if vlan.dhcp_enabled %}
ip dhcp excluded-address {{ vlan.gateway }}
!
ip dhcp pool {{ vlan.site }}_{{ vlan.name }}
 network {{ vlan.prefix | ipv4_network }} {{ vlan.prefix | ipv4_netmask }}
 default-router {{ vlan.gateway }}
{% if vlan.dhcp_dns_server %}
 dns-server {{ vlan.dhcp_dns_server }}
{% endif %}
!
{% endif %}
{% endfor %}
{% for site in design.sites %}
interface Loopback0
 description {{ site.name }} router-id
 ip address {{ site.router_id }} 255.255.255.255
 ip ospf {{ design.ospf_process_id }} area {{ design.ospf_area }}
!
{% endfor %}
{% for link in design.p2p_links %}
interface {{ link.interface }}
 description P2P to {{ link.peer }}
 ip address {{ link.local_address }} 255.255.255.254
 ip ospf network point-to-point
 ip ospf {{ design.ospf_process_id }} area {{ design.ospf_area }}
 no shutdown
!
{% endfor %}
router ospf {{ design.ospf_process_id }}
 router-id {{ design.sites[0].router_id }}
 passive-interface default
{% for link in design.p2p_links %}
 no passive-interface {{ link.interface }}
{% endfor %}
!